# SolTrade environment: copy this file to .env and fill in the values.
# .env is git-ignored; never commit it. Real environment variables override it.

# --- Secrets ---
# Solana wallet private key (base58) that signs the swaps. Required to trade live; --dry-run
# works without it. Export it from your wallet, and use a new wallet with small amounts.
SOLTRADE_PRIVATE_KEY=

# Jupiter API key. Optional: without it the default swap/v2 endpoint runs keyless at a lower
# rate limit. Get one from Jupiter's developer portal.
SOLTRADE_JUPITER_API_KEY=

# --- Paths (set these in the real environment, not here: they're read before .env loads) ---
# SOLTRADE_CONFIG_PATH   config.json to use. Default: config.json in the project folder
# SOLTRADE_DOTENV_PATH   .env to load. Default: .env in the project folder
# SOLTRADE_LOG_DIR       Folder for the log files. Default: logs/ in the project folder
